<%
const scripts = [];
if (hasGeo) scripts.push('/assets/vendor/leaflet/leaflet.js');
if (series.length >= 2) scripts.push('/assets/vendor/chart.umd.js');
const eventLabel = { listed: 'Listed', price_change: 'Price changed', sold: 'Sold', removed: 'Taken off the market', relisted: 'Listed again' };
const dataLabels = { full: 'Full details', limited: 'Limited details', link_only: 'Link only', link_dead: 'Link no longer works', removed: 'Listing removed or sold' };
const original = p.watch_url || p.source_url;
%>
<%- include('partials/header', { title: p.address, active: '', opt: { map: hasGeo } }) %>
<nav class="crumbs" aria-label="Back">
  <a href="<%= url('/search', { q: backQ }) %>"><%- icon('arrow-left', 14) %><%= backQ %></a>
  <% if (p.watch_id) { %><span>·</span><a href="/pipeline">Pipeline</a><% } %>
</nav>

<header class="p-head">
  <div>
    <div class="tags">
      <%- statusTag(p) %>
      <% if (p.property_type) { %><span class="tag"><%= p.property_type %></span><% } %>
      <% if (p.source === 'manual') { %><span class="tag">Added by hand</span><% } %>
      <span class="tag tag-data-<%= p.data_status %>" title="How much of the listing we have"><%= dataLabels[p.data_status] || p.data_status %></span>
      <% for (const fl of (p.flags || '').split(',').filter(Boolean)) { %><span class="tag tag-warn"><%= CONDITION_FLAGS[fl] || fl %></span><% } %>
    </div>
    <h1 class="display"><%= p.address %></h1>
    <p class="where"><%= [p.city, [p.state, p.zip].filter(Boolean).join(' ')].filter(Boolean).join(', ') %><%= p.county ? ' · ' + p.county + ' County' : '' %></p>
  </div>
  <div class="p-price">
    <% if (headline) { %>
      <div class="price"><%= money(headline) %></div>
      <p class="sub">
        <% if (forSale) { %>
          <%= pp ? '$' + Math.round(pp).toLocaleString('en-US') + '/sqft' : 'Asking price' %><%= dom !== null ? ' · ' + (dom === 0 ? 'listed today' : plural(dom, 'day') + ' on the market') : '' %>
        <% } else { %>
          Last sold <%= fmtDate(p.last_sale_date) %><%= pp ? ' · $' + Math.round(pp).toLocaleString('en-US') + '/sqft' : '' %>
        <% } %>
      </p>
    <% } else { %>
      <p class="sub">No price on file yet.</p>
    <% } %>
    <div class="actions head-actions">
      <% if (original) { %>
      <a class="btn btn-sm" href="<%= original %>" target="_blank" rel="noopener noreferrer"><%- icon('external-link', 14) %>View original listing</a>
      <% } %>
      <% if (canEdit && !p.watch_id) { %>
      <form method="post" action="/property/<%= p.id %>/act" class="inline">
        <%- csrfField() %><input type="hidden" name="do" value="watch">
        <button class="btn btn-sm btn-primary" type="submit"><%- icon('star', 14) %>Add to pipeline</button>
      </form>
      <% } %>
    </div>
  </div>
</header>

<% if (p.watch_id && PIPELINE_ACTIVE.includes(p.watch_stage || '') && p.owner_id && user && p.owner_id !== user.id) { %>
<p class="claim-bar"><%- icon('user-check', 16) %><span><strong><%= p.owner_name %></strong> is handling this home — <%= PIPELINE_STAGES[p.watch_stage] %> since <%= fmtDate(p.stage_at, 'M j') %>. Coordinate before contacting the agent.</span></p>
<% } %>

<%- include('partials/scorebar') %>

<div class="facts-strip">
  <div><b><%= p.beds !== null ? trimNum(p.beds) : '—' %></b><span>Bedrooms</span></div>
  <div><b><%= p.baths !== null ? trimNum(p.baths) : '—' %></b><span>Bathrooms</span></div>
  <div><b><%= p.sqft ? num(p.sqft) : '—' %></b><span>Sqft living area</span></div>
  <div><b><%= formatLot(p.lot_sqft) %></b><span>Lot</span></div>
  <div><b><%= p.year_built || '—' %></b><span>Year built</span></div>
  <div><b><%= p.hoa_fee !== null ? (p.hoa_fee > 0 ? '$' + num(p.hoa_fee) : 'None') : '—' %></b><span>HOA per month</span></div>
</div>

<div class="p-cols">
  <div>
    <% if (p.description) { %>
    <section class="section">
      <div class="section-head"><h2>From the listing</h2></div>
      <p class="desc"><%= p.description %></p>
    </section>
    <% } %>

    <%- include('partials/deal') %>
    <%- include('partials/condition') %>

    <section class="section" id="comps">
      <div class="section-head"><h2>Comparable sales</h2>
        <span class="aside">within <%= trimNum(comps.radius) %> mi · last <%= comps.months %> months<%= comps.widened ? ' (widened)' : '' %></span></div>

      <% if (!hasGeo) { %>
        <p class="blank">This address has no map position, so nearby sales can’t be matched.</p>
      <% } else if (!comps.comps.length) { %>
        <p class="blank">No recorded sales on file within <%= trimNum(comps.radius) %> mile<%= comps.radius == 1 ? '' : 's' %>. Widen the radius or add a sale by hand.</p>
      <% } else { %>
        <div class="comp-sum">
          <div><b><%= stats.count %></b><span>Sales matched</span></div>
          <div><b><%= money(stats.median_price) %></b><span>Median price</span></div>
          <div><b><%= stats.median_ppsf ? '$' + Math.round(stats.median_ppsf).toLocaleString('en-US') : '—' %></b><span>Median $/sqft</span><% if (pp && stats.median_ppsf) { const gapP = (pp - stats.median_ppsf) / stats.median_ppsf * 100; %><span class="<%= gapP > 0 ? 'up' : 'down' %>">this home <%= pct(gapP, 0) %></span><% } %></div>
          <div><b><%= stats.value ? money(stats.value) : '—' %></b><span>Implied value</span><span><%= stats.value ? moneyShort(stats.value_low) + ' – ' + moneyShort(stats.value_high) : 'needs 3 sales with sqft' %></span></div>
        </div>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th>Address</th><th>Sold</th><th class="r">Price</th><th class="r">$/sqft</th><th class="r">Size</th><th class="r">Away</th><th class="r" title="How alike: distance, size, age, recency">Match</th></tr></thead>
            <tbody>
            <% for (const c of comps.comps) { %>
              <tr data-pid="<%= c.id %>">
                <td><a class="main" href="/property/<%= c.id %>"><%= c.address %></a>
                  <span class="sub"><%= propertyFacts(c) || '—' %></span></td>
                <td class="nowrap"><%= fmtDate(c.last_sale_date, 'M j, Y') %></td>
                <td class="r"><%= money(c.last_sale_price) %></td>
                <td class="r"><%= c.ppsf ? '$' + Math.round(c.ppsf).toLocaleString('en-US') : '—' %></td>
                <td class="r"><%= c.sqft ? num(c.sqft) : '—' %></td>
                <td class="r"><%= c.distance.toFixed(2) %> mi</td>
                <td class="r"><span class="score<%= c.compScore >= 70 ? '' : (c.compScore >= 50 ? ' mid' : ' low') %>"><%= c.compScore %></span></td>
              </tr>
            <% } %>
            </tbody>
          </table>
        </div>
      <% } %>

      <% if (hasGeo) { %>
      <form class="toolbar" method="get" action="/property/<%= p.id %>#comps">
        <label class="small muted" for="r">Radius</label>
        <select class="select" id="r" name="r" data-autosubmit>
          <% for (const r of COMP_RADII) { %><option value="<%= r %>"<%= selected(comps.radius, r) %>><%= r %> mi</option><% } %>
        </select>
        <label class="small muted" for="m">Sold in the last</label>
        <select class="select" id="m" name="m" data-autosubmit>
          <% for (const m of COMP_MONTHS) { %><option value="<%= m %>"<%= selected(comps.months, m) %>><%= m %> months</option><% } %>
        </select>
        <a class="small" href="<%= url('/add', { near: p.id }) %>">Add a sale by hand</a>
      </form>
      <% } %>
    </section>

    <section class="section">
      <div class="section-head"><h2>Price history</h2></div>
      <% if (!events.length) { %>
        <p class="blank">No listing or sale events on file.</p>
      <% } else { %>
        <% if (series.length >= 2) { %>
        <div class="chart-box short"><canvas data-chart="price-chart" aria-label="Price history chart" role="img"></canvas></div>
        <script type="application/json" id="price-chart"><%- jsonEmbed({ format: 'usd', labels: series.map((s) => s.x), series: [{ name: 'Price', data: series.map((s) => s.y), points: true, stepped: true }] }) %></script>
        <% } %>
        <ol class="timeline">
          <% events.forEach((ev, i) => {
               let prev = null;
               for (let j = i + 1; j < events.length; j++) { if (events[j].price > 0) { prev = events[j].price; break; } }
               const chg = (ev.event === 'price_change' && prev && ev.price > 0) ? (ev.price - prev) / prev * 100 : null;
          %>
          <li>
            <span class="when"><%= fmtDate(ev.event_date) %></span>
            <span><%= eventLabel[ev.event] || ev.event %><% if (chg !== null) { %> <span class="<%= chg < 0 ? 'down' : 'up' %> num"><%= pct(chg) %></span><% } %></span>
            <span class="amt"><%= money(ev.price) %></span>
          </li>
          <% }) %>
        </ol>
      <% } %>
    </section>

    <% if (p.agent_name || p.office_name || p.mls_number) { %>
    <section class="section">
      <div class="section-head"><h2>Listed by</h2></div>
      <dl class="kv">
        <% if (p.agent_name) { %><div><dt>Agent</dt><dd><%= p.agent_name %></dd></div><% } %>
        <% if (p.agent_phone) { %><div><dt>Phone</dt><dd><a href="tel:<%= p.agent_phone.replace(/[^0-9+]/g, '') %>"><%= fmtPhone(p.agent_phone) %></a></dd></div><% } %>
        <% if (p.agent_email) { %><div><dt>Email</dt><dd><a href="mailto:<%= p.agent_email %>"><%= p.agent_email %></a></dd></div><% } %>
        <% if (p.office_name) { %><div><dt>Brokerage</dt><dd><%= p.office_name %></dd></div><% } %>
        <% if (p.mls_number) { %><div><dt>MLS #</dt><dd><%= p.mls_number %><%= p.mls_name ? ' · ' + p.mls_name : '' %></dd></div><% } %>
      </dl>
    </section>
    <% } %>

    <%- include('partials/team') %>
  </div>

  <aside class="rail">
    <% if (hasGeo) { %>
    <div class="mini-map"><div id="map"></div></div>
    <script type="application/json" id="map-data"><%- jsonEmbed({ points, zoom: 15, labels: points.length <= 20, circle: comps.comps.length ? { lat: p.lat, lng: p.lng, miles: comps.radius } : null }) %></script>
    <% } %>

    <%- include('partials/pipeline_card') %>

    <% if (p.est_value || p.est_rent) { %>
    <div class="card estimate">
      <span class="eyebrow"><%= p.est_source === 'zestimate' ? 'Zestimate' : 'RentCast estimate' %></span>
      <% if (p.est_value) { %>
        <div class="price"><%= money(p.est_value) %></div>
        <% if (p.est_value_low && p.est_value_high) { %>
          <%- rangeBar(p.est_value_low, p.est_value_high, forSale ? (p.list_price || p.est_value) : p.est_value) %>
          <div class="range-ends"><span><%= moneyShort(p.est_value_low) %></span><span><%= forSale ? 'marker = asking price' : '' %></span><span><%= moneyShort(p.est_value_high) %></span></div>
        <% } %>
        <% if (forSale && p.list_price) { const gap = (p.list_price - p.est_value) / p.est_value * 100; %>
          <p class="small soft">Asking is <span class="<%= gap > 0 ? 'up' : 'down' %>"><%= pct(gap) %></span> against the estimate.</p>
        <% } %>
      <% } %>
      <% if (p.est_rent) { %>
        <div class="ctx-row"><span>Rent estimate</span><span class="num"><%= money(p.est_rent) %>/mo</span></div>
        <% if (headline) { %><div class="ctx-row"><span>Gross yield</span><span class="num"><%= (p.est_rent * 12 / headline * 100).toFixed(1) %>%</span></div><% } %>
      <% } %>
      <p class="small muted">An automated figure, checked <%= ago(p.est_at) %>. Trust the sold comps more.</p>
    </div>
    <% } %>

    <% if (links.length) { %>
    <div class="card">
      <h3>Look it up elsewhere</h3>
      <div class="linklist">
        <% for (const l of links) { %>
        <a href="<%= l.url %>" target="_blank" rel="noopener noreferrer"><%= l.name %><%- icon('arrow-up-right', 14) %></a>
        <% } %>
      </div>
      <% if (original) { %>
      <p class="small mt-m"><a href="<%= original %>" target="_blank" rel="noopener noreferrer">Original listing link</a></p>
      <% } %>
      <p class="small muted mt-s"><a href="/sites">Edit this list</a></p>
    </div>
    <% } %>

    <% if (hasGeo) { %>
    <div class="card" data-context-url="/api/context/<%= p.id %>">
      <h3>Flood risk</h3>
      <div class="ctx" data-flood><div class="skeleton"></div><div class="skeleton"></div></div>
      <h3 class="mt-l">Nearby, within a mile</h3>
      <div class="ctx" data-nearby-url="/api/nearby/<%= p.id %>" data-csrf="<%= csrfToken %>"><div class="skeleton"></div><div class="skeleton"></div></div>
      <h3 class="mt-l">Neighbourhood</h3>
      <div class="ctx" data-hood><div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div></div>
    </div>
    <% } %>

    <div class="card">
      <h3>This record</h3>
      <p class="small muted">Source: <%= ({ rentcast: 'RentCast', openwebninja: 'Zillow data', manual: 'entered by hand', import: 'CSV import' }[p.source] || p.source) %><%= p.source_site ? ' · found on ' + p.source_site : '' %>. First on file <%= fmtDate(p.first_seen_at) %>.</p>
      <% if (canEdit) { %>
      <form method="post" action="/property/<%= p.id %>/act" class="mt-m">
        <%- csrfField() %><input type="hidden" name="do" value="data_status">
        <label class="field"><span>What we have from the listing</span>
          <select class="select" name="data_status" data-autosubmit>
            <% for (const [k, label] of Object.entries(dataLabels)) { %><option value="<%= k %>"<%= selected(p.data_status, k) %>><%= label %></option><% } %>
          </select></label>
      </form>
      <div class="actions mt-m">
        <a class="btn btn-sm" href="<%= url('/add', { id: p.id }) %>"><%- icon('pencil', 14) %>Edit facts &amp; price</a>
        <% if (canAdmin) { %>
        <form method="post" action="/property/<%= p.id %>/act" class="inline" data-confirm="Delete this home, its deal numbers, notes and history? This can’t be undone.">
          <%- csrfField() %><input type="hidden" name="do" value="delete">
          <button class="btn btn-sm btn-danger" type="submit"><%- icon('trash-2', 14) %>Delete</button>
        </form>
        <% } %>
      </div>
      <% } %>
    </div>
  </aside>
</div>
<%- include('partials/footer', { scripts }) %>
