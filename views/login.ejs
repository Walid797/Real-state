<%- include('partials/header', { title: 'Sign in', active: '', opt: { bare: true } }) %>
<section class="bare-side">
  <a class="brand" href="/login"><%= siteName %></a>
  <form class="bare-form" method="post" action="/login" autocomplete="on">
    <%- csrfField() %>
    <input type="hidden" name="next" value="<%= next %>">
    <h1 class="display">Sign in</h1>
    <p class="soft">Private to your team.</p>
    <% if (error) { %><p class="err" role="alert"><%= error %></p><% } %>
    <label class="field">
      <span>Email</span>
      <input class="input" type="email" name="email" value="<%= email %>" autocomplete="username" required autofocus>
    </label>
    <label class="field">
      <span>Password</span>
      <input class="input" type="password" name="password" autocomplete="current-password" required>
    </label>
    <div class="actions">
      <button class="btn btn-primary" type="submit">Sign in</button>
    </div>
    <p class="small muted mt-m">Demo accounts: <span class="mono">admin@plat.local</span> (Admin), <span class="mono">partner@example.com</span> (Partner), <span class="mono">viewer@example.com</span> (Viewer) · password <span class="mono">correct horse battery staple</span></p>
  </form>
  <form method="post" action="/login" class="mt-s">
    <%- csrfField() %>
    <input type="hidden" name="next" value="<%= next %>">
    <input type="hidden" name="email" value="admin@plat.local">
    <input type="hidden" name="password" value="correct horse battery staple">
    <button class="btn btn-sm" type="submit">Quick sign in as Alex Rivera (Admin)</button>
  </form>
  <p class="small muted">Not indexed by search engines. Sessions end after 14 days.</p>
</section>
<aside class="bare-art" aria-hidden="true">
  <svg class="plat" viewBox="0 0 600 800" preserveAspectRatio="xMidYMid slice" fill="none" stroke="#3d4b47" stroke-width="1">
    <path d="M-20 120 L640 60 M-20 300 L640 250 M-20 480 L640 450 M-20 660 L640 650"/>
    <path d="M90 -20 L60 820 M250 -20 L235 820 M410 -20 L400 820 M545 -20 L548 820"/>
    <path d="M250 280 L405 268 L402 462 L240 470 Z" stroke="#14b8a6" stroke-width="1.5"/>
    <path d="M90 113 L250 98 M235 300 L60 310" stroke-dasharray="4 6"/>
    <circle cx="322" cy="368" r="3" fill="#14b8a6" stroke="none"/>
  </svg>
  <blockquote>Know what the house next door sold for before you make the call.</blockquote>
  <cite>Lot 14 · Block 3</cite>
</aside>
<%- include('partials/footer', { scripts: [] }) %>
