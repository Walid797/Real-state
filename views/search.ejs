<% if (!f.q) { %>
<%- include('partials/header', { title: 'Search', active: 'search', opt: {} }) %>
<header class="page-head">
  <div>
    <h1 class="display">Find the next deal</h1>
    <p>Search all of <%= stateName %> or any part of it. Every filter takes a minimum and a maximum; leave a box empty for “any”.</p>
  </div>
  <div class="actions">
    <a class="btn" href="<%= url('/search', { q: 'Austin, TX', types: typesDefault, sort: 'score' }) %>"><%- icon('trophy', 15) %>Austin best opportunities</a>
    <a class="btn" href="<%= url('/search', { q: stateName, types: typesDefault, sort: 'score' }) %>"><%- icon('trophy', 15) %>Statewide best opportunities</a>
  </div>
</header>

<form method="get" action="/search" role="search" class="filter-page">
  <%- include('partials/filter_form', { landing: true }) %>
  <div class="form-foot sticky-foot">
    <button class="btn btn-primary" type="submit"><%- icon('search', 15) %>Search</button>
    <a class="btn btn-ghost" href="/search">Reset</a>
    <span class="small muted">Searches saved research listings and local sales comparables.</span>
  </div>
</form>

<section class="section">
  <div class="section-head"><h2>My search profiles</h2><span class="aside">each can have its own alert</span></div>
  <% if (saved.length) { %>
  <ul class="plain-list">
    <% for (const s of saved) { const p = s.params || {}; %>
    <li>
      <a class="main" href="<%= url('/search', p) %>"><%= s.name %><span class="sub"><%= describeSearch(p) %></span></a>
      <span class="end nowrap">
        <a class="linkbtn" href="<%= url('/alerts/new', { ...p, kind: p.mode === 'sold' ? 'new_sale' : 'new_listing' }) %>">Alert me</a> ·
        <form method="post" action="/search/act" class="inline" data-confirm="Delete this profile?">
          <%- csrfField() %><input type="hidden" name="do" value="unsave"><input type="hidden" name="id" value="<%= s.id %>">
          <button class="linkbtn muted" type="submit">Delete</button>
        </form></span>
    </li>
    <% } %>
  </ul>
  <% } else { %>
  <p class="blank">Run a search and press <strong>Save as profile</strong> — for example “Townhouses under $350K” or “Fixer-uppers with high profit”.</p>
  <% } %>
</section>
<%- include('partials/footer', { scripts: [] }) %>
<% } else { %>
<%- include('partials/header', { title: (loc ? loc.label : 'Search') + (mode === 'sold' ? ' — sold' : ''), active: 'search', opt: { wide: true, map: true } }) %>
<form class="sbar" method="get" action="/search" role="search">
  <div class="sbar-row">
    <label class="q"><span class="sr">Area</span><%- icon('search', 16) %>
      <input class="input" type="search" name="q" value="<%= f.q %>" autocomplete="off" required></label>
    <span class="seg" role="group" aria-label="Listing type">
      <label><input type="radio" name="mode" value="sale"<%= checked(mode === 'sale') %> data-autosubmit><span>For sale</span></label>
      <label><input type="radio" name="mode" value="sold"<%= checked(mode === 'sold') %> data-autosubmit><span>Sold</span></label>
    </span>
    <details class="drop drop-wide"<%= openDrawer ? ' open' : '' %>>
      <summary class="btn"><%- icon('filter', 14) %>Filters<% if (activeFilters) { %><span class="count"><%= activeFilters %></span><% } %></summary>
      <div class="drop-panel drop-panel-wide">
        <%- include('partials/filter_form', { landing: false }) %>
        <div class="form-foot"><button class="btn btn-primary" type="submit">Apply</button>
          <a class="btn btn-ghost" href="<%= url('/search', { q: f.q, mode: mode === 'sold' ? 'sold' : null }) %>">Clear all</a></div>
      </div>
    </details>
    <label><span class="sr">Sort</span>
      <select class="select sort-select" name="sort" data-autosubmit>
        <% for (const [k, label] of Object.entries(PROPERTY_SORTS)) { %><option value="<%= k %>"<%= selected(f.sort, k) %>><%= label %></option><% } %>
      </select></label>
    <button class="btn btn-primary" type="submit">Search</button>
  </div>
  <% if (activeFilters) { %><p class="sbar-desc"><%= describeSearch(f) %></p><% } %>
</form>

<div class="results">
  <div class="results-list">
    <% if (res.error) { %>
      <div class="empty">
        <%- sketch('search-unclear') %>
        <h1 class="display">Couldn’t read that place.</h1>
        <p><%= res.error %></p>
      </div>
    <% } else { %>
      <header class="results-head">
        <h1 class="display"><%= num(res.total) %> <%= mode === 'sold' ? (res.total === 1 ? 'sale' : 'sales') : (res.total === 1 ? 'home' : 'homes') %> <span class="muted-h">in <%= loc.label %></span></h1>
        <p class="results-meta">
          <% if (res.snapshot) { %>
            From saved research (updated <%= ago(res.snapshot.fetched_at) %>).
          <% } else { %>
            From saved data.
          <% } %>
          <% if (mode === 'sale') { %> Profit, ARV and scores are estimates — open a home to see how each was worked out.<% } %>
        </p>
      </header>

      <div class="results-tools">
        <form method="post" action="/search/act" class="inline">
          <%- csrfField() %><input type="hidden" name="do" value="save">
          <input type="hidden" name="params" value="<%= JSON.stringify(query) %>">
          <button class="btn btn-sm" type="submit"><%- icon('bookmark', 14) %>Save as profile</button>
        </form>
        <a class="btn btn-sm" href="<%= url('/alerts/new', { ...query, kind: mode === 'sold' ? 'new_sale' : 'new_listing' }) %>"><%- icon('bell', 14) %>Alert me</a>
        <% if (res.total > 0) { %>
        <a class="btn btn-sm" href="<%= url('/export.csv', query) %>"><%- icon('file-spreadsheet', 14) %>CSV</a>
        <% } %>
      </div>

      <% if (!res.rows.length) { %>
        <div class="empty">
          <%- sketch('search-none') %>
          <% if (anyInArea > 0) { %>
            <h2 class="display">Nothing matches those filters.</h2>
            <p><%= plural(anyInArea, 'home') %> <%= mode === 'sold' ? 'sold' : 'are for sale' %> in <%= loc.label %> without them. Condition and investment filters only match homes whose listing text was read or analysed.</p>
            <p><a class="btn" href="<%= url('/search', { q: f.q, mode: mode === 'sold' ? 'sold' : null }) %>">Clear filters</a></p>
          <% } else { %>
            <h2 class="display">Nothing on file for <%= loc.label %> yet.</h2>
            <p>Add homes from any listing link or enter them by hand — try Austin, TX or Richmond, VA for seeded sample listings.</p>
            <p class="actions"><a class="btn btn-primary" href="/add">Add a home</a></p>
          <% } %>
        </div>
      <% } else { %>
        <div class="rows">
        <% for (const r of res.rows) {
             const price = mode === 'sold' ? r.last_sale_price : r.list_price;
             const pp = ppsf(price, r.sqft);
             const dom = propertyDom(r);
             const band = scoreBand(r.score);
             const flags = (r.flags || '').split(',').filter(Boolean);
        %>
          <article class="hrow hrow-x" data-pid="<%= r.id %>">
            <div class="price"><%= money(price) %>
              <% if (pp) { %><small>$<%= Math.round(pp).toLocaleString('en-US') %>/sqft</small><% } %></div>
            <div class="body">
              <a class="addr" href="/property/<%= r.id %>"><%= r.address %></a>
              <span class="where"><%= r.city %>, <%= r.state %> <%= r.zip %></span>
              <div class="facts"><%= propertyFacts(r) || 'Details not on file' %><%= r.property_type ? ' · ' + r.property_type : '' %></div>
              <div class="chips">
                <% if (mode === 'sale' && r.est_profit !== null) { %>
                  <span class="chip <%= r.est_profit > 0 ? 'chip-good' : 'chip-bad' %>">Profit <%= moneyShort(Math.abs(r.est_profit)) %><%= r.est_profit < 0 ? ' loss' : '' %></span>
                  <% if (r.est_arv) { %><span class="chip">ARV <%= moneyShort(r.est_arv) %></span><% } %>
                <% } %>
                <% if (r.cond_overall && r.cond_overall !== 'not_disclosed') { %><span class="chip chip-cond"><%= CONDITION_OVERALL[r.cond_overall] || r.cond_overall %></span><% } %>
                <% for (const fl of flags) { %><span class="chip chip-warn"><%= CONDITION_FLAGS[fl] || fl %></span><% } %>
                <% if (r.has_basement) { %><span class="chip">Basement</span><% } %>
                <% if (r.watch_stage) { %><span class="chip chip-stage"><%= PIPELINE_STAGES[r.watch_stage] || r.watch_stage %><%= r.owner_name ? ' · ' + r.owner_name : '' %></span><% } %>
              </div>
            </div>
            <div class="side">
              <% if (mode === 'sale') { %>
              <span class="score-badge score-<%= band %>" title="Opportunity score<%= r.risk !== null ? ' · risk ' + r.risk : '' %>"><%= r.score !== null ? r.score : '—' %></span>
              <% } %>
              <span class="side-meta">
                <% if (mode === 'sold') { %>Sold <%= fmtDate(r.last_sale_date) %>
                <% } else if (dom !== null) { %><%= dom === 0 ? 'Listed today' : (dom === 1 ? '1 day' : dom + ' days') %><% } %>
              </span>
              <% if (canEdit) { %>
              <form method="post" action="/property/<%= r.id %>/act">
                <%- csrfField() %><input type="hidden" name="do" value="<%= r.watch_id ? 'unwatch' : 'watch' %>"><input type="hidden" name="back" value="<%= reqUrl %>">
                <button class="star<%= r.watch_id ? ' is-on' : '' %>" type="submit" title="<%= r.watch_id ? 'In the pipeline — remove' : 'Add to the team pipeline' %>"><%- icon('star', 17) %><span class="sr"><%= r.watch_id ? 'Remove from pipeline' : 'Add to pipeline' %></span></button>
              </form>
              <% } %>
            </div>
          </article>
        <% } %>
        </div>
        <%- pager(res.total, per, page, query) %>
      <% } %>

      <% if (elsewhere.length) { %>
      <p class="elsewhere"><span>Same area on</span>
        <% for (const s of elsewhere) { %><a href="<%= s.url %>" target="_blank" rel="noopener noreferrer"><%= s.name %></a><% } %>
      </p>
      <% } %>
    <% } %>
  </div>

  <aside class="results-map" aria-label="Map of results">
    <div id="map"></div>
    <script type="application/json" id="map-data"><%- jsonEmbed({ points, wheel: true }) %></script>
  </aside>
</div>
<%- include('partials/footer', { scripts: ['/assets/vendor/leaflet/leaflet.js'] }) %>
<% } %>
