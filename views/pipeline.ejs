<%- include('partials/header', { title: 'Pipeline', active: 'pipeline', opt: {} }) %>
<header class="page-head">
  <div>
    <h1 class="display">Pipeline</h1>
    <p>Homes the team is working. One status per home, one person handling it — so nobody chases a house someone else is already negotiating.</p>
  </div>
  <% if (canEdit) { %><div class="actions"><a class="btn btn-primary" href="/add?watch=1"><%- icon('plus', 15) %>Add from a link</a></div><% } %>
</header>

<div class="stage-strip" role="list">
  <% for (const [k, l] of Object.entries(PIPELINE_STAGES)) { %>
  <a role="listitem" class="stage-pill stage-<%= k %>" href="#st-<%= k %>"><span><%= l %></span><b><%= counts[k] || 0 %></b></a>
  <% } %>
</div>

<form class="toolbar" method="get" action="/pipeline">
  <span class="seg seg-sm" role="group" aria-label="Whose">
    <label><input type="radio" name="who" value=""<%= checked(who !== 'me') %> data-autosubmit><span>Everyone</span></label>
    <label><input type="radio" name="who" value="me"<%= checked(who === 'me') %> data-autosubmit><span>Handled by me</span></label>
  </span>
  <span class="seg seg-sm" role="group" aria-label="Which">
    <% for (const [k, l] of [['open', 'Open'], ['closed', 'Closed'], ['all', 'All']]) { %>
    <label><input type="radio" name="show" value="<%= k %>"<%= checked(show === k) %> data-autosubmit><span><%= l %></span></label>
    <% } %>
  </span>
</form>

<% if (!rows.length) { %>
  <div class="empty">
    <%- sketch('pipeline-empty') %>
    <h2 class="display">Nothing here.</h2>
    <p>Star a home in the search results, or paste a link from Homes.com, Zillow, Realtor.com or Redfin. It lands here as “New”.</p>
    <p class="actions"><a class="btn btn-primary" href="/search">Search</a><% if (canEdit) { %><a class="btn" href="/add?watch=1">Add from a link</a><% } %></p>
  </div>
<% } %>

<% for (const [stage, label] of Object.entries(PIPELINE_STAGES)) {
     const list = byStage[stage] || [];
     if (!list.length) continue;
%>
<section class="section" id="st-<%= stage %>">
  <div class="section-head"><h2><%= label %></h2><span class="aside"><%= plural(list.length, 'home') %></span></div>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Home</th><th class="r">Price</th><th class="r">Est. profit</th><th class="r">Score</th><th>Handled by</th><th>Updated</th><th>Status</th></tr></thead>
      <tbody>
      <% for (const r of list) {
           const sale = r.status === 'for_sale' || r.status === 'pending';
           const price = sale ? (r.list_price || 0) : (r.last_sale_price || 0);
           const first = r.first_price || 0;
           const delta = (sale && first > 0 && price > 0 && first !== price) ? (price - first) / first * 100 : null;
           const band = scoreBand(r.score);
      %>
        <tr>
          <td><a class="main" href="/property/<%= r.id %>"><%= r.address %></a>
            <span class="sub"><%= r.city %>, <%= r.state %> · <%= propertyFacts(r) || 'details not on file' %><%= r.note_count ? ' · ' + plural(r.note_count, 'note') : '' %></span></td>
          <td class="r"><%= money(price) %><% if (delta !== null) { %><span class="sub <%= delta < 0 ? 'down' : 'up' %>"><%= pct(delta) %> since listed</span><% } else { %><span class="sub"><%= sale ? 'asking' : (r.status === 'sold' ? 'sold' : 'off market') %></span><% } %></td>
          <td class="r"><%- r.est_profit !== null ? `<span class="${r.est_profit < 0 ? 'up' : 'down'}">${e(moneyShort(Math.abs(r.est_profit)))}</span>` : '—' %></td>
          <td class="r"><span class="score-badge sm score-<%= band %>"><%= r.score !== null ? r.score : '—' %></span></td>
          <td><%- r.owner_name ? e(r.owner_name) : '<span class="muted">No one</span>' %></td>
          <td class="nowrap"><%= ago(r.stage_at) %><% if (r.stage_by) { %><span class="sub">by <%= r.stage_by %></span><% } %></td>
          <td>
            <% if (canEdit) { %>
            <form method="post" action="/property/<%= r.id %>/act">
              <%- csrfField() %><input type="hidden" name="do" value="stage"><input type="hidden" name="back" value="/pipeline">
              <label class="sr" for="st<%= r.id %>">Status</label>
              <select class="select stage" id="st<%= r.id %>" name="stage" data-autosubmit>
                <% for (const [k, l] of Object.entries(PIPELINE_STAGES)) { %><option value="<%= k %>"<%= selected(r.watch_stage, k) %>><%= l %></option><% } %>
              </select>
            </form>
            <% } else { %><%= label %><% } %>
          </td>
        </tr>
      <% } %>
      </tbody>
    </table>
  </div>
</section>
<% } %>
<%- include('partials/footer', { scripts: [] }) %>
