<%- include('partials/header', { title: edit ? 'Edit ' + edit.address : 'Add a home', active: 'add', opt: {} }) %>
<% if (edit) { %><nav class="crumbs"><a href="/property/<%= editId %>"><%- icon('arrow-left', 14) %><%= edit.address %></a></nav><% } %>
<div class="narrow">
  <header class="page-head">
    <div>
      <h1 class="display"><%= edit ? 'Edit facts & price' : (near ? 'Add a sale nearby' : 'Add a home') %></h1>
      <p><% if (edit) { %>Change the asking price here and the old one is kept in the price history.<% } else if (near) { %>A sale you found elsewhere, close to <%= near.address %>. It joins the comparable sales straight away.<% } else { %>Found something on Zillow, Redfin or a yard sign? Enter it once — it shows up in searches, comps and alerts like any other home.<% } %></p>
    </div>
  </header>

  <% for (const err of errors) { %><p class="flash flash-err" role="alert"><%= err %></p><% } %>

  <% if (!edit && !near) { %>
  <section class="card link-card">
    <h3><%- icon('link-2', 16) %> Add from a listing link</h3>
    <p class="small soft mb-m">Paste a home’s page from Homes.com, Zillow, Realtor.com, Redfin or Trulia. The address is read from the link itself and the home goes into the team pipeline with a “View original listing” button.</p>
    <% if (linkError) { %><p class="err" role="alert"><%= linkError %></p><% } %>
    <form method="post" action="/add">
      <%- csrfField() %><input type="hidden" name="do" value="link">
      <div class="form-grid">
        <label class="field c8"><span>Listing link</span><input class="input" type="url" name="url" value="<%= linkUrl %>" placeholder="https://www.zillow.com/homedetails/139-E-Del-Rio-Dr-Austin-TX-78704/7594920_zpid/" required></label>
        <label class="field c4"><span>Asking price (optional)</span><input class="input" name="price" inputmode="numeric" placeholder="$"></label>
        <label class="field c12"><span>Note for the team (optional)</span><input class="input" name="note" placeholder="Seen on Homes.com — price cut last week, vacant."></label>
      </div>
      <div class="form-foot"><button class="btn btn-primary" type="submit"><%- icon('plus', 15) %>Add from link</button></div>
    </form>
  </section>
  <h2 class="eyebrow mt-l mb-m">Or type it in</h2>
  <% } %>

  <form method="post" action="<%= url('/add', { id: editId || null }) %>">
    <%- csrfField() %>
    <% if (edit) { %><input type="hidden" name="id" value="<%= editId %>"><% } %>
    <div class="form-grid">
      <label class="field c12"><span>Street address</span>
        <input class="input" name="address" value="<%= form.address %>" placeholder="1204 Maple St" <%= edit ? 'readonly' : 'required autofocus' %> autocomplete="off"></label>
      <label class="field c6"><span>City</span><input class="input" name="city" value="<%= form.city %>"<%= edit ? ' readonly' : '' %>></label>
      <label class="field c3"><span>State</span><input class="input" name="state" value="<%= form.state %>" maxlength="20" placeholder="TX"<%= edit ? ' readonly' : '' %>></label>
      <label class="field c3"><span>ZIP</span><input class="input" name="zip" value="<%= form.zip %>" inputmode="numeric" maxlength="5"<%= edit ? ' readonly' : '' %>></label>

      <label class="field c4"><span>Status</span>
        <select class="select" name="status">
          <% for (const [k, label] of [['for_sale', 'For sale'], ['pending', 'Pending'], ['sold', 'Sold'], ['off_market', 'Off market']]) { %><option value="<%= k %>"<%= selected(form.status, k) %>><%= label %></option><% } %>
        </select></label>
      <label class="field c4"><span>Asking price</span><input class="input" name="list_price" value="<%= form.list_price ? Math.round(Number(form.list_price)).toLocaleString('en-US') : '' %>" inputmode="numeric" placeholder="$"></label>
      <label class="field c4"><span>Listed on</span><input class="input" type="date" name="listed_date" value="<%= form.listed_date %>"></label>
      <label class="field c4"><span>Last sale price</span><input class="input" name="last_sale_price" value="<%= form.last_sale_price ? Math.round(Number(form.last_sale_price)).toLocaleString('en-US') : '' %>" inputmode="numeric" placeholder="$"></label>
      <label class="field c4"><span>Sold on</span><input class="input" type="date" name="last_sale_date" value="<%= form.last_sale_date %>"></label>
      <label class="field c4"><span>Type</span>
        <select class="select" name="property_type"><option value="">Not sure</option>
          <% for (const t of PROPERTY_TYPES) { %><option<%= selected(form.property_type, t) %>><%= t %></option><% } %>
        </select></label>

      <label class="field c2"><span>Beds</span><input class="input" name="beds" value="<%= form.beds %>" inputmode="decimal"></label>
      <label class="field c2"><span>Baths</span><input class="input" name="baths" value="<%= form.baths %>" inputmode="decimal"></label>
      <label class="field c3"><span>Living area, sqft</span><input class="input" name="sqft" value="<%= form.sqft %>" inputmode="numeric"></label>
      <label class="field c3"><span>Lot, sqft</span><input class="input" name="lot_sqft" value="<%= form.lot_sqft %>" inputmode="numeric"></label>
      <label class="field c2"><span>Built</span><input class="input" name="year_built" value="<%= form.year_built %>" inputmode="numeric" maxlength="4"></label>
      <label class="field c4"><span>HOA, $ per month</span><input class="input" name="hoa_fee" value="<%= form.hoa_fee %>" inputmode="decimal"></label>
      <label class="field c8"><span>Link to the listing</span><input class="input" type="url" name="source_url" value="<%= form.source_url %>" placeholder="https://www.zillow.com/homedetails/…"></label>

      <label class="field c12"><span><%= edit ? 'Add a note for the team' : 'Note for the team' %></span>
        <textarea class="textarea" name="notes" rows="3" placeholder="Corner lot, backs onto the greenbelt."><%= form.notes %></textarea></label>
      <div class="field c12"><label class="check"><input type="checkbox" name="watch"<%= checked(form.watch) %>>In the team pipeline</label></div>
    </div>
    <div class="form-foot">
      <button class="btn btn-primary" type="submit"><%= edit ? 'Save changes' : 'Add home' %></button>
      <a class="btn btn-ghost" href="<%= edit ? '/property/' + editId : '/' %>">Cancel</a>
    </div>
  </form>
</div>
<%- include('partials/footer', { scripts: [] }) %>
