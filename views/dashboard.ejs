<%- include('partials/header', { title: 'Dashboard', active: 'dashboard', opt: {} }) %>
<header class="page-head">
  <div>
    <p class="eyebrow"><%= fmtDate(todayStr, 'l, F j') %></p>
    <h1 class="display"><%= hello ? `Hello, ${hello}.` : 'Dashboard' %></h1>
    <p><%= k.good ? plural(k.good, 'strong opportunity', 'strong opportunities') + ' on file' : 'No strong opportunities on file yet' %><%= k.mine ? `, ${plural(k.mine, 'home')} waiting on you` : '' %>.</p>
  </div>
  <form class="quick-search" method="get" action="/search" role="search">
    <label class="sr" for="dq">Search an area</label>
    <%- icon('search', 16) %><input class="input" id="dq" type="search" name="q" placeholder="<%= stateName %>, a county, a city or ZIPs" required>
    <input type="hidden" name="types[]" value="Single Family"><input type="hidden" name="types[]" value="Townhouse">
    <input type="hidden" name="sort" value="score">
    <button class="btn btn-primary" type="submit">Search</button>
  </form>
</header>

<div class="kpis">
  <a class="kpi" href="<%= url('/search', { q: stateName }) %>"><span>Homes for sale on file</span><b><%= num(k.homes) %></b><small><%= k.newCount ? '+' + num(k.newCount) + ' this week' : 'none new this week' %></small></a>
  <a class="kpi kpi-good" href="<%= url('/search', { q: stateName, score_min: 70, sort: 'score' }) %>"><span>Strong opportunities</span><b><%= num(k.good) %></b><small>score 70 or more</small></a>
  <a class="kpi" href="<%= url('/search', { q: stateName, listing: ['reduced'], sort: 'score' }) %>"><span>Price cuts this week</span><b><%= num(k.cuts) %></b><small>still for sale</small></a>
  <a class="kpi" href="/pipeline"><span>Under team review</span><b><%= num(k.review) %></b><small><%= k.mine ? k.mine + ' handled by you' : 'none handled by you' %></small></a>
</div>

<div class="dash-grid">
  <section class="section">
    <div class="section-head"><h2>Best opportunities now</h2><a class="aside" href="<%= url('/search', { q: stateName, sort: 'score' }) %>">All, by score</a></div>
    <% if (top.length) { %>
    <ul class="plain-list opp-list">
      <% for (const r of top) { %>
      <li>
        <span class="score-badge sm score-<%= scoreBand(r.score) %>"><%= r.score %></span>
        <a class="main" href="/property/<%= r.id %>"><%= r.address %>, <%= r.city %>
          <span class="sub"><%= money(r.list_price) %> · <%= r.facts %><%= r.watch_stage ? ' · ' + (PIPELINE_STAGES[r.watch_stage] || r.watch_stage) + (r.owner_name ? ' (' + r.owner_name + ')' : '') : '' %></span></a>
        <span class="end"><% if (r.est_profit !== null) { %><b class="<%= r.est_profit < 0 ? 'up' : 'down' %> num"><%= moneyShort(Math.abs(r.est_profit)) %></b><br>est. profit<% } %></span>
      </li>
      <% } %>
    </ul>
    <% } else { %>
    <div class="blank-sketch"><%- sketch('dashboard-start') %><p class="blank">Search an area — every listing that comes in is scored on profit, ROI, price, ARV evidence, condition and risk.</p></div>
    <% } %>
  </section>

  <section class="section">
    <div class="section-head"><h2>Recent price cuts</h2></div>
    <% if (cuts.length) { %>
    <ul class="plain-list">
      <% for (const c of cuts) { const d = (c.price - c.before_price) / c.before_price * 100; %>
      <li><a class="main" href="/property/<%= c.id %>"><%= c.address %><span class="sub"><%= c.city %> · <%= fmtDate(c.event_date, 'M j') %></span></a>
        <span class="end"><span class="num"><%= moneyShort(c.before_price) %> → <b><%= moneyShort(c.price) %></b></span><br><span class="down"><%= pct(d) %></span></span></li>
      <% } %>
    </ul>
    <% } else { %>
    <p class="blank">Price cuts show up here when an area is pulled again and an asking price has dropped.</p>
    <% } %>

    <div class="section-head mt-l"><h2>Pipeline</h2><a class="aside" href="/pipeline">Open</a></div>
    <div class="stage-mini">
      <% for (const [key, label] of Object.entries(PIPELINE_STAGES)) { %>
      <a href="/pipeline#st-<%= key %>"><span><%= label %></span><b><%= stageCounts[key] || 0 %></b></a>
      <% } %>
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2>Team activity</h2></div>
    <% if (activity.length) { %>
    <ul class="plain-list feed">
      <% for (const a of activity) { %>
      <li><span><strong><%= a.who %></strong> · <%= a.detail %>
        <% if (a.address) { %><a class="sub" href="/property/<%= a.property_id %>"><%= a.address %>, <%= a.city %></a><% } %></span>
        <span class="end"><%= ago(a.created_at) %></span></li>
      <% } %>
    </ul>
    <% } else { %>
    <p class="blank">Statuses, notes and deal changes from everyone on the team appear here.</p>
    <% } %>

    <div class="section-head mt-l"><h2>Shortcuts</h2></div>
    <div class="shortcuts">
      <a href="/search"><%- icon('search', 16) %>Search homes</a>
      <a href="/pipeline"><%- icon('kanban', 16) %>Saved homes</a>
      <a href="/alerts"><%- icon('bell', 16) %>Alerts<%= alertsOn ? ' · ' + alertsOn + ' on' : '' %></a>
      <a href="/reports"><%- icon('file-spreadsheet', 16) %>Reports</a>
      <% if (canEdit) { %><a href="/add"><%- icon('link-2', 16) %>Add from a link</a><% } %>
      <% if (canAdmin) { %><a href="/users"><%- icon('users', 16) %>Team</a><% } %>
    </div>
  </section>
</div>
<p class="section-note">Profit, ARV and scores are estimates from public data and your settings. They are not appraisals, inspections or advice.</p>
<%- include('partials/footer', { scripts: [] }) %>
