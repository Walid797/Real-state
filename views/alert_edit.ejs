<%- include('partials/header', { title: alert ? alert.name : 'New alert', active: 'alerts', opt: {} }) %>
<nav class="crumbs"><a href="/alerts"><%- icon('arrow-left', 14) %>Alerts</a></nav>
<div class="narrow">
  <header class="page-head">
    <div>
      <h1 class="display"><%= alert ? alert.name : 'New alert' %></h1>
      <% if (alert) { %><p>Created <%= fmtDate(alert.created_at) %> · <%= alert.last_checked_at ? 'last checked ' + ago(alert.last_checked_at) : 'not checked yet' %></p><% } %>
    </div>
  </header>

  <% for (const err of errors) { %><p class="flash flash-err" role="alert"><%= err %></p><% } %>

  <form method="post" action="<%= alert ? '/alerts/' + alert.id : '/alerts/new' %>">
    <%- csrfField() %>
    <div class="form-grid">
      <label class="field c6"><span>Tell me about</span>
        <select class="select" name="kind" data-kind-switch>
          <% for (const [k, label] of Object.entries(ALERT_KINDS)) { %><option value="<%= k %>"<%= selected(form.kind, k) %>><%= label %></option><% } %>
        </select></label>
      <label class="field c6"><span>Area</span>
        <input class="input" name="location" value="<%= form.location %>" placeholder="Austin, TX · Travis County · 78704">
        <small data-kind="price_drop">Optional. Empty covers every home in the pipeline.</small></label>

      <% for (const [label, k] of [['Price ($)', 'price'], ['Bedrooms', 'beds'], ['Bathrooms', 'baths'], ['Living area (sqft)', 'sqft'], ['Year built', 'year'], ['Lot (sqft)', 'lot']]) { %>
      <div class="field c4" data-kind="new_listing new_sale"><span><%= label %></span><div class="pair">
        <input class="input" name="<%= k %>_min" inputmode="decimal" placeholder="Min" value="<%= critVal(k + '_min') %>" aria-label="<%= label %> minimum">
        <input class="input" name="<%= k %>_max" inputmode="decimal" placeholder="Max" value="<%= critVal(k + '_max') %>" aria-label="<%= label %> maximum"></div></div>
      <% } %>
      <label class="field c4" data-kind="new_listing"><span>HOA up to, $/mo</span><input class="input" name="hoa_max" inputmode="numeric" value="<%= critVal('hoa_max') %>" placeholder="0 = none"></label>
      <label class="field c4" data-kind="new_listing"><span>Opportunity score, at least</span><input class="input" name="score_min" inputmode="numeric" value="<%= critVal('score_min') %>" placeholder="e.g. 60"></label>
      <label class="field c4" data-kind="new_listing"><span>Est. profit, at least ($)</span><input class="input" name="profit_min" inputmode="numeric" value="<%= critVal('profit_min') %>" placeholder="e.g. 35,000"></label>

      <div class="field c12" data-kind="new_listing"><span>Listing status</span>
        <div class="actions">
          <% for (const [k, label] of Object.entries(LISTING_FILTER_LABELS)) { %>
          <label class="check"><input type="checkbox" name="listing[]" value="<%= k %>"<%= checked((crit.listing || []).includes(k)) %>><%= label %></label>
          <% } %>
        </div><small>None ticked = any active listing.</small></div>
      <div class="field c12" data-kind="new_listing"><span>Condition</span>
        <div class="actions">
          <% for (const [k, label] of Object.entries(CONDITION_OVERALL)) { %>
          <label class="check"><input type="checkbox" name="cond[]" value="<%= k %>"<%= checked((crit.cond || []).includes(k)) %>><%= label %></label>
          <% } %>
        </div><small>None ticked = any condition.</small></div>

      <div class="field c12" data-kind="new_listing new_sale"><span>Property type</span>
        <div class="actions">
          <% for (const t of PROPERTY_TYPES) { %>
          <label class="check"><input type="checkbox" name="types[]" value="<%= t %>"<%= checked((crit.types || []).includes(t)) %>><%= t %></label>
          <% } %>
        </div>
        <small>None ticked means any type.</small></div>

      <label class="field c6" data-kind="price_drop"><span>Only cuts of at least</span>
        <input class="input" name="min_drop_pct" inputmode="decimal" value="<%= crit.min_drop_pct ?? '' %>" placeholder="e.g. 3 (%)">
        <small>Leave empty to hear about every cut.</small></label>

      <label class="field c6"><span>Check</span>
        <select class="select" name="every_hours">
          <% for (const [h, label] of Object.entries(ALERT_FREQUENCIES)) { %><option value="<%= h %>"<%= selected(form.every_hours, h) %>><%= label %></option><% } %>
        </select></label>
      <div class="field c6"><span>When</span>
        <span class="seg" role="group" aria-label="When to send">
          <label><input type="radio" name="delivery" value="instant"<%= checked(form.delivery !== 'daily') %>><span>As soon as found</span></label>
          <label><input type="radio" name="delivery" value="daily"<%= checked(form.delivery === 'daily') %>><span>Daily summary</span></label>
        </span></div>
      <div class="field c6"><span>Send to</span>
        <div class="actions">
          <% for (const [ch, label] of [['email', 'Email'], ['telegram', 'Telegram'], ['whatsapp', 'WhatsApp']]) { %>
          <label class="check"><input type="checkbox" name="channels[]" value="<%= ch %>"<%= checked(form.channels.includes(ch)) %>><%= label %></label>
          <% } %>
        </div></div>

      <div class="field c12">
        <label class="check"><input type="checkbox" name="enabled"<%= checked(form.enabled) %>>Alert is on</label>
      </div>
      <label class="field c12"><span>Name</span>
        <input class="input" name="name" value="<%= form.name %>" placeholder="Leave empty and it names itself"></label>
    </div>

    <div class="form-foot">
      <button class="btn btn-primary" type="submit"><%= alert ? 'Save changes' : 'Create alert' %></button>
      <a class="btn btn-ghost" href="/alerts">Cancel</a>
    </div>
  </form>

  <% if (alert) { %>
  <section class="section">
    <div class="section-head"><h2>What it has sent</h2>
      <form method="post" action="/alerts/<%= alert.id %>/act" class="inline"><%- csrfField() %><input type="hidden" name="do" value="run"><button class="linkbtn" type="submit">Check now</button></form></div>
    <% if (!history.length) { %>
      <p class="blank"><%= alert.last_note || 'Nothing yet.' %></p>
    <% } else { %>
    <ul class="plain-list">
      <% for (const h of history) { %>
      <li><a class="main" href="/property/<%= h.pid %>"><%= h.address %>, <%= h.city %><span class="sub"><%= h.summary %></span></a>
        <span class="end"><span class="num"><%= money(h.price) %></span><br><%= fmtDate(h.created_at, 'M j, g:i a') %></span></li>
      <% } %>
    </ul>
    <% } %>
  </section>

  <section class="section">
    <div class="section-head"><h2>Remove</h2></div>
    <form method="post" action="/alerts/<%= alert.id %>/act" class="mt-m" data-confirm="Delete this alert and its history?">
      <%- csrfField() %><input type="hidden" name="do" value="delete">
      <button class="btn btn-danger btn-sm" type="submit"><%- icon('trash-2', 14) %>Delete this alert</button>
    </form>
  </section>
  <% } %>
</div>
<%- include('partials/footer', { scripts: [] }) %>
