<%- include('partials/header', { title: 'Reports', active: 'reports', opt: {} }) %>
<header class="page-head">
  <div>
    <h1 class="display">Reports</h1>
    <p>Where the homes are, what they cost, which ones look best — and how the team’s finished projects compared with the estimates.</p>
  </div>
  <div class="actions no-print">
    <a class="btn" href="/export.csv?report=1"><%- icon('file-spreadsheet', 15) %>CSV</a>
    <button class="btn" type="button" data-print><%- icon('printer', 15) %>PDF / print</button>
  </div>
</header>
<p class="print-only small">Printed <%= fmtDate(nowStr, 'F j, Y g:i a') %> · estimates, not appraisals.</p>

<nav class="setting-nav no-print" aria-label="Report sections">
  <% for (const t of tables) { %><a href="#r-<%= t.key %>"><%= t.title %></a><% } %>
</nav>

<% for (const t of tables) { %>
<section class="section report" id="r-<%= t.key %>">
  <div class="section-head"><h2><%= t.title %></h2><span class="aside"><%= t.note %></span></div>
  <% if (!t.rows.length) { %>
    <p class="blank">Nothing to show yet.</p>
  <% } else { %>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><% t.header.forEach((h, i) => { %><th<%= i >= 2 ? ' class="r"' : '' %>><%= h %></th><% }) %></tr></thead>
      <tbody>
      <% for (const row of t.rows) { %>
        <tr>
        <% t.header.forEach((_, i) => { const v = row[i]; %>
          <td<%= i >= 2 ? ' class="r"' : '' %>><%
            if (i === 0 && t.link !== undefined) {
              %><a class="main" href="/property/<%= row[t.link] %>"><%= v %></a><%
            } else if (v === null || v === undefined || v === '') {
              %><span class="muted">—</span><%
            } else if ((t.money || []).includes(i)) {
              %><%= (Number(v) < 0 ? '−' : '') + money(Math.abs(Number(v)), '$0') %><%
            } else if (typeof v === 'number' && !Number.isInteger(v)) {
              %><%= v.toFixed(1) %><%
            } else if (typeof v === 'number') {
              %><%= num(v) %><%
            } else {
              %><%= v %><%
            }
          %></td>
        <% }) %>
        </tr>
      <% } %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>
<% } %>
<%- include('partials/footer', { scripts: [] }) %>
