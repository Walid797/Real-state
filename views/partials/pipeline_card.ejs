<div class="card pipe-card">
  <h3>Team status</h3>
  <% if (!p.watch_id) { %>
    <p class="small muted mb-m">Not in the pipeline. Add it so the team can track it.</p>
    <% if (canEdit) { %>
    <form method="post" action="/property/<%= p.id %>/act"><%- csrfField() %><input type="hidden" name="do" value="watch">
      <button class="btn btn-sm btn-primary" type="submit"><%- icon('star', 14) %>Add to pipeline</button></form>
    <% } %>
  <% } else { %>
    <% if (canEdit) { %>
    <form method="post" action="/property/<%= p.id %>/act" class="pipe-form">
      <%- csrfField() %><input type="hidden" name="do" value="stage">
      <label class="field"><span>Status</span>
        <select class="select" name="stage" data-autosubmit>
          <% for (const [k, l] of Object.entries(PIPELINE_STAGES)) { %><option value="<%= k %>"<%= selected(p.watch_stage, k) %>><%= l %></option><% } %>
        </select></label>
    </form>
    <form method="post" action="/property/<%= p.id %>/act" class="pipe-form">
      <%- csrfField() %><input type="hidden" name="do" value="owner">
      <label class="field"><span>Handled by</span>
        <select class="select" name="owner_id" data-autosubmit>
          <option value="">No one yet</option>
          <% for (const m of team) { %><option value="<%= m.id %>"<%= selected(p.owner_id ?? '', m.id) %>><%= m.name %></option><% } %>
        </select></label>
    </form>
    <% } else { %>
    <div class="ctx-row"><span>Status</span><span><%= PIPELINE_STAGES[p.watch_stage] || p.watch_stage %></span></div>
    <div class="ctx-row"><span>Handled by</span><span><%= p.owner_name || 'No one yet' %></span></div>
    <% } %>
    <p class="small muted mt-s">Changed <%= ago(p.stage_at) %><%= p.stage_by ? ' by ' + p.stage_by : '' %>.</p>
    <% if (canEdit) { %>
    <form method="post" action="/property/<%= p.id %>/act" class="mt-s" data-confirm="Take this home out of the team pipeline? Notes and deal numbers stay.">
      <%- csrfField() %><input type="hidden" name="do" value="unwatch">
      <button class="linkbtn small muted" type="submit">Remove from pipeline</button></form>
    <% } %>
  <% } %>
</div>
