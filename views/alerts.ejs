<%- include('partials/header', { title: 'Alerts', active: 'alerts', opt: {} }) %>
<header class="page-head">
  <div>
    <h1 class="display">Alerts</h1>
    <p>Tell it what you’re after. When a match turns up you get the price, the facts and the links by email, WhatsApp or Telegram.</p>
  </div>
  <div class="actions"><a class="btn btn-primary" href="/alerts/new"><%- icon('plus', 15) %>New alert</a></div>
</header>

<% if (!alerts.length) { %>
  <div class="empty">
    <%- sketch('alerts-empty') %>
    <h2 class="display">No alerts yet.</h2>
    <p>Three kinds are worth having: a <strong>new listing</strong> that fits your budget and size, a <strong>price cut</strong> on a home you’re watching, and a <strong>new sale</strong> near a home you care about.</p>
    <p><a class="btn btn-primary" href="/alerts/new">Create the first one</a></p>
  </div>
<% } else { %>
  <section class="section">
    <div class="section-head"><h2>Your alerts</h2><span class="aside"><%= lastRun ? 'scheduler ran ' + ago(lastRun) : '' %></span></div>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>On</th><th>Alert</th><th>Checks</th><th>Sends to</th><th>Last check</th><th class="r">Sent</th><th></th></tr></thead>
        <tbody>
        <% for (const a of alerts) {
             const crit = a.criteria || {};
             let desc = describeSearch({ ...crit, q: a.location, mode: a.kind === 'new_sale' ? 'sold' : 'sale', sold_days: 90 });
             if (a.kind === 'price_drop') {
               desc = ((a.location ? a.location + ' · ' : '') + 'pipeline homes' + (crit.min_drop_pct ? ' · cut of ' + trimNum(crit.min_drop_pct) + '% or more' : '')).trim();
             }
        %>
          <tr>
            <td>
              <form method="post" action="/alerts/<%= a.id %>/act">
                <%- csrfField() %><input type="hidden" name="do" value="toggle">
                <button class="toggle" type="submit" aria-pressed="<%= a.enabled ? 'true' : 'false' %>" title="<%= a.enabled ? 'On — click to pause' : 'Paused — click to turn on' %>"><span class="sr"><%= a.enabled ? 'Pause' : 'Turn on' %> <%= a.name %></span></button>
              </form>
            </td>
            <td><a class="main" href="/alerts/<%= a.id %>"><%= a.name %></a>
              <span class="sub"><%= ALERT_KINDS[a.kind] || a.kind %> · <%= desc %><%= a.delivery === 'daily' ? ' · daily summary' : '' %></span></td>
            <td class="nowrap"><%= ALERT_FREQUENCIES[a.every_hours] || ('Every ' + a.every_hours + 'h') %></td>
            <td><% for (const ch of (a.channels || [])) { %>
              <span class="tag"><%= ch.charAt(0).toUpperCase() + ch.slice(1) %></span>
            <% } %></td>
            <td><%- a.last_checked_at ? e(ago(a.last_checked_at)) : '<span class="muted">Not yet</span>' %>
              <% if (a.last_note) { %><span class="sub"><%= a.last_note %></span><% } %></td>
            <td class="r"><%= a.sent %></td>
            <td class="r nowrap">
              <form method="post" action="/alerts/<%= a.id %>/act" class="inline">
                <%- csrfField() %><input type="hidden" name="do" value="run">
                <button class="linkbtn" type="submit">Check now</button>
              </form>
            </td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2>Recently sent</h2></div>
    <% if (!hits.length) { %>
      <p class="blank">Nothing sent yet. Press “Check now” on an alert to run a check against current listings.</p>
    <% } else { %>
    <ul class="plain-list">
      <% for (const h of hits) { %>
      <li>
        <a class="main" href="/property/<%= h.pid %>"><%= h.address %>, <%= h.city %>
          <span class="sub"><%= h.summary %> · <%= h.alert_name %></span></a>
        <span class="end"><span class="num"><%= money(h.price) %></span><br><%= ago(h.created_at) %></span>
      </li>
      <% } %>
    </ul>
    <% } %>
  </section>
<% } %>
<%- include('partials/footer', { scripts: [] }) %>
