# This folder holds application code. Only /public is meant to be reachable
# from the web; on shared hosting the folder may also sit under another
# site's document root, so everything here is closed by default.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
