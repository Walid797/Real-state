# Plat — private settings. Copy to .env next to config.php (never commit .env).
# These are read from here and are not shown or editable under Settings.

# Data sources
RENTCAST_API_KEY=
OPENWEBNINJA_API_KEY=
CENSUS_API_KEY=
CESIUM_ION_TOKEN=

# Mailbox that sends alerts (SMTP) and receives listing e-mails (IMAP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993

# Telegram bot for alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Sign in with Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
